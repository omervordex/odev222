# Copy this file to .env and fill in real values locally.
# Never commit the .env file. Never put real keys in this example.

# Server
PORT=3000
NODE_ENV=development

# Supabase project
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Safe to use later in a browser only after Row Level Security is in place.
# This project does not send it to the browser yet.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server only. Bypasses Row Level Security. Never put this in frontend code.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Signs the admin session cookie. Use a long random value. Never commit the real one.
SESSION_SECRET=replace-with-a-long-random-string

# Used only by `npm run admin:create`. Do not put a real password in source control.
# The script refuses to replace an administrator that already exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
