<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="wordmark" href="/"><%= store.name %></a>
      <p><%= store.address %></p>
      <a href="tel:<%= store.phoneTel %>"><%= store.phoneDisplay %></a>
    </div>
    <div>
      <p class="footer-label">Ziyaret</p>
      <a href="/">Ana Sayfa</a>
      <a href="/products">Koleksiyon</a>
      <a href="/find-your-frame">Gözlük Stilini Keşfet</a>
      <a href="/about">Hakkımızda</a>
      <a href="/contact">İletişim</a>
    </div>
    <div>
      <p class="footer-label">Sosyal</p>
      <a href="<%= store.instagram %>" rel="noopener noreferrer">Instagram</a>
      <a href="<%= store.facebook %>" rel="noopener noreferrer">Facebook</a>
    </div>
  </div>
  <div class="shell footer-base">
    <p><%= store.location %> · <%= store.hours %></p>
  </div>
</footer>
<script src="/js/main.js"></script>
</body>
</html>
