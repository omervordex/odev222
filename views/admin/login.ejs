<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Yönetim</title>
  <link rel="stylesheet" href="/vendor/tabler/css/tabler.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-login">
  <div class="login-shell">
    <p class="login-kicker">Yönetim</p>
    <a class="login-wordmark" href="/admin/login"><%= storeName %></a>
    <form class="card card-md" method="post" action="/admin/login" novalidate>
      <div class="card-body">
        <h1 class="h2 text-center mb-4">Giriş yap</h1>
          <% if (loginError) { %>
            <div class="alert alert-danger" role="alert"><%= loginError %></div>
          <% } %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label class="form-label" for="email">E-posta</label>
            <input class="form-control" id="email" name="email" type="email" value="<%= email %>" autocomplete="username" required>
          </div>
          <div class="mb-3">
            <label class="form-label" for="password">Şifre</label>
            <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required>
          </div>
          <div class="form-footer">
            <button class="btn btn-primary w-100" type="submit">Giriş yap</button>
          </div>
        </div>
      </form>
    <p class="text-center text-secondary mt-3">Herkese açık kayıt yoktur.</p>
  </div>
</body>
</html>
